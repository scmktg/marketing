# Supabase — shared dev project (v1). See README §Local development.
# Each developer points at the same shared dev project for v1 simplicity.
# v2 should move to local Supabase CLI when team size grows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by Drizzle migrations and seed scripts.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — real API calls in dev. No mocking.
# Use a SEPARATE dev API key with a hard budget cap set on the OpenAI dashboard
# (manager's manual step — recommended USD 20/day for dev, scaling at scaffold time).
OPENAI_API_KEY=sk-...

# OPENAI_MODE controls which model tier the dev environment uses.
#   production  — top-tier reasoning model (matches what prod will run)
#   cheap       — cheapest currently-available model (for iteration without burning budget)
# Code that resolves the model lives in lib/ai/model.ts and is the only place
# that reads this env var. Production deployments must set OPENAI_MODE=production.
OPENAI_MODE=cheap

# Resend — internal team email (digests, alerts). NOT used for marketing.
RESEND_API_KEY=re_...
RESEND_FROM=alerts@your-domain.example

# Inngest — local dev runs `npx inngest-cli dev`; these are populated only in prod.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry — optional in dev, required in prod.
SENTRY_DSN=
